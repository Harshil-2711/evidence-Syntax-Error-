# Environment variables for the Evidence-Gated Self-Healing Agent
# Copy to .env and fill in values before running the agent layer.
# The deterministic foundation does NOT require any of these.

# --- LLM (future agent layer) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# --- Application settings ---
# LOG_LEVEL=INFO
# SANDBOX_MODE=memory        # memory | redis | postgres (future)
# MAX_RETRIES=3
# EVIDENCE_TIMEOUT_SECONDS=30
